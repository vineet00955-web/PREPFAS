# PrepFast Frontend Environment Configuration

# Backend FastAPI URL (defaults to http://localhost:8000 if omitted)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Credentials (optional - falls back to Local / Demo Storage if empty)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

